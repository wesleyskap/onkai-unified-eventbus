<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EventBus.Core\EventBus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.5.0</Version>
    <Authors>Wesley Lima</Authors>
    <Description>RabbitMQ provider implementation for Onkai EventBus.</Description>
    <PackageId>Onkai.EventBus.RabbitMQ</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
     <RepositoryUrl>https://github.com/wesleyskap/onkai-unified-eventbus</RepositoryUrl>
  </PropertyGroup>

</Project>
